# LiveKit (required for token API)
# Copy from livekit-voice-agent/.env.local or use the same values.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Public URL for the browser (optional; defaults to LIVEKIT_URL)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Public HTTPS URL of this Next app (optional). Used for the phone-mic QR if set.
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Overrides QR link only (optional). Same as NEXT_PUBLIC_APP_URL if either is set, QR uses it
# instead of LAN IP detection — e.g. tunnel or production URL from a local dev machine.
# iPhone Safari blocks the mic on http://LAN addresses; use an https:// tunnel or deployed URL.
# JOIN_QR_BASE_URL=https://your-app.vercel.app

# npm run dev:lan sets JOIN_QR_USE_HTTPS=1 so the phone QR uses https:// on your LAN (needed for iPhone mic).
# Override only if you must: JOIN_QR_USE_HTTPS=0
